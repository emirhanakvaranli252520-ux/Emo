davalar/*
!davalar/_sablon/

# Python
__pycache__/
*.pyc
.venv/

# Sistem
.DS_Store
Thumbs.db

# Eval verileri (lisans gereği repoya konmaz)
evals/veri/

# Ice aktarilan evrak kutuphanesi (kisisel veri icerebilir)
kutuphane/
